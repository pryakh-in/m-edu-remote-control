# Пароль входа в админку учителя. Обязательно смените.
TEACHER_PASSWORD=смените-меня

# Ключ подписи cookie. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Если не задать, ключ создаётся заново при каждом старте и все сессии сбрасываются.
SECRET_KEY=

# Брендирование
SCHOOL_NAME=Школа №1409
LAB_NAME=Лаборатория Promobot M Edu

# Каталог для robots.json и журнала запусков кода (в Docker — том /data)
DATA_DIR=data

# Реестр роботов. Пусто = адреса по умолчанию из app/config.py.
# Реестр также правится в админке (/admin/robots) и сохраняется в DATA_DIR/robots.json.
# Поля: id, name, host, panel_port (80), ros_port (9090), rest_port (8081), enabled (true)
# ROBOTS_JSON=[{"id":"central-front","name":"Центральный передний","host":"192.168.103.192"}]

# Интервал опроса статусов роботов, секунды
STATUS_POLL_INTERVAL=12

# Таймаут вызовов rosbridge и предельное время выполнения программы, секунды
ROS_TIMEOUT=8
CODE_TIMEOUT=600

# Время жизни сессии ученика (минуты) и таймаут его heartbeat (секунды)
SESSION_TTL_MINUTES=480
STUDENT_HEARTBEAT_TIMEOUT=90

# Приложение внутри контейнера слушает 9000. В Coolify задайте Ports Exposes = 9000
# и не пробрасывайте порт на хост (Traefik ходит по внутренней сети).
